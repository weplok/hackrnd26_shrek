# OpenAI-compatible provider. Required only for POST /dialogue.
OPENAI_BASE_URL=
OPENAI_API_KEY=
NPC_MODEL=
INJECTION_JUDGE_MODEL=
ALARM_JUDGE_MODEL=

# Claude Code LLM. The backend shells out to the locally installed Claude Code
# CLI. CLAUDE_CODE_PRIORITY=1 makes it the primary LLM (OpenAI then optional and
# used only as fallback); CLAUDE_CODE_FALLBACK=1 keeps OpenAI primary and uses
# Claude Code only on error. Set at most one. CLAUDE_CODE_MODEL/BIN are optional.
# compose.yaml mounts the host claude binary and credentials into the container;
# override the CLAUDE_HOST_* paths below only if the host install differs.
CLAUDE_CODE_FALLBACK=
CLAUDE_CODE_PRIORITY=
CLAUDE_CODE_MODEL=
CLAUDE_CODE_BIN=
CLAUDE_HOST_BIN=
CLAUDE_HOST_CREDS=
CLAUDE_HOST_CONFIG=

# General API. Empty values use application defaults.
ANONYMOUS_SESSION_TTL_SECONDS=
RATE_LIMIT_WINDOW_SECONDS=
SESSION_RATE_LIMIT=
DIALOGUE_RATE_LIMIT=
LLM_REQUEST_TIMEOUT_SECONDS=
DIALOGUE_TIMEOUT_SECONDS=
TELEMETRY_RETENTION_DAYS=

# Docker Compose. Keep COMPOSE_PROFILES=online for full stack. Replace password before deployment.
COMPOSE_PROFILES=online
WEB_PORT=8080
POSTGRES_DB=zero_day
POSTGRES_USER=zero_day
POSTGRES_PASSWORD=local-only-change-before-deploy

# Optional paths. Empty values use repository-local defaults.
NPC_IDS_PATH=
NPC_SESSION_DB_PATH=

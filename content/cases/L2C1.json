  "report": {
    "findings": [
      {
        "id": "f_wifi",
        "vuln": "SL-02",
        "node": "guest_wifi",
        "options": [
          {
            "id": "o1",
            "text": "Задать длинный уникальный пароль гостевой сети и отделить её от внутренней.",
            "correct": true
          },
          {
            "id": "o2",
            "text": "Оставить простой пароль, он же «для удобства».",
            "correct": false
          }
        ],
        "explanation": "Простой гостевой пароль — вход во всю сеть. Нужен сильный пароль и изоляция гостевого сегмента."
      },
      {
        "id": "f_portal",
        "vuln": "SL-04",
        "node": "portal",
        "options": [
          {
            "id": "o1",
            "text": "Обновить CMS портала и наладить регулярный патч-менеджмент.",
            "correct": true
          },
          {
            "id": "o2",
            "text": "Закрыть портал от поисковиков.",
            "correct": false
          }
        ],
        "explanation": "Известная уязвимость старой версии закрывается обновлением и инвентаризацией компонентов."
      },
      {
        "id": "f_teacher",
        "vuln": "SL-07",
        "node": "teacher_pc",
        "options": [
          {
            "id": "o1",
            "text": "Удалить забытые тестовые учётки и ввести аудит аккаунтов.",
            "correct": true
          },
          {
            "id": "o2",
            "text": "Сменить обои на рабочем столе.",
            "correct": false
          }
        ],
        "explanation": "Забытая учётка test_svc давала доступ в обе зоны. Такие аккаунты удаляют и регулярно проверяют."
      },
      {
        "id": "f_gateway",
        "vuln": "SL-08",
        "node": "gateway",
        "options": [
          {
            "id": "o1",
            "text": "Исправить правила шлюза и усилить сегментацию сети.",
            "correct": true
          },
          {
            "id": "o2",
            "text": "Добавить ещё один гостевой Wi-Fi.",
            "correct": false
          }
        ],
        "explanation": "Щель в правилах позволила перейти в админскую зону. Сегментацию чинят правилами и аудитом."
      },
      {
        "id": "f_controller",
        "vuln": "SL-06",
        "node": "controller",
        "options": [
          {
            "id": "o1",
            "text": "Включить MFA на контроллер и урезать доверенные связи (least privilege).",
            "correct": true
          },
          {
            "id": "o2",
            "text": "Переименовать контроллер домена.",
            "correct": false
          }
        ],
        "explanation": "По доверенной связи можно было дойти до ядра. Помогают MFA, сегментация и минимальные права."
      }
    ]
  },

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flipper",
  "description": "content/flipper.json: Flipper lines by trigger.",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/definitions/SchemaVersion" },
    "lines": { "type": "array", "items": { "$ref": "#/definitions/FlipperLine" }, "minItems": 1 }
  },
  "required": ["schemaVersion", "lines"],
  "additionalProperties": false,
  "definitions": {
    "FlipperLine": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "trigger": {
          "type": "object",
          "properties": {
            "event": { "$ref": "common.schema.json#/definitions/EventType" },
            "when": { "$ref": "common.schema.json#/definitions/Condition" }
          },
          "required": ["event"],
          "additionalProperties": false
        },
        "text": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 90 },
          "minItems": 1
        },
        "cooldownTicks": { "type": "integer", "minimum": 0 },
        "minLevel": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxLevel": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "required": ["id", "trigger", "text", "cooldownTicks"],
      "additionalProperties": false
    }
  }
}

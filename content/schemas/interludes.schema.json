{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interludes",
  "description": "content/interludes.json.",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/definitions/SchemaVersion" },
    "items": { "type": "array", "items": { "$ref": "#/definitions/Interlude" } }
  },
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "definitions": {
    "Interlude": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "title": { "$ref": "common.schema.json#/definitions/Text" },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "$ref": "common.schema.json#/definitions/Text" },
              "illustration": { "type": "string" }
            },
            "required": ["text"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "effects": { "$ref": "common.schema.json#/definitions/Effects" }
      },
      "required": ["id", "title", "slides"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Npc",
  "description": "content/npc/<id>.json: persona, suspicion, facts and the scripted rule table.",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/definitions/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/definitions/Id" },
    "name": { "$ref": "common.schema.json#/definitions/Text" },
    "persona": {
      "type": "object",
      "properties": {
        "role": { "$ref": "common.schema.json#/definitions/Text" },
        "character": { "$ref": "common.schema.json#/definitions/Text" },
        "speechStyle": { "$ref": "common.schema.json#/definitions/Text" }
      },
      "required": ["role", "character", "speechStyle"],
      "additionalProperties": false
    },
    "suspicion": {
      "type": "object",
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lockAt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cooldownTicks": { "type": "integer", "minimum": 0 }
      },
      "required": ["start", "lockAt"],
      "additionalProperties": false
    },
    "greeting": { "$ref": "common.schema.json#/definitions/Id" },
    "facts": { "type": "array", "items": { "$ref": "#/definitions/Fact" } },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/Rule" }, "minItems": 1 },
    "scriptedLines": { "type": "array", "items": { "$ref": "#/definitions/Line" }, "minItems": 1 },
    "llm": {
      "type": "object",
      "properties": {
        "systemPromptRef": { "type": "string", "minLength": 1 },
        "allowedFactIds": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Id" }, "uniqueItems": true }
      },
      "required": ["systemPromptRef", "allowedFactIds"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "id", "name", "persona", "suspicion", "greeting", "facts", "rules", "scriptedLines"],
  "additionalProperties": false,
  "definitions": {
    "Fact": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "text": { "$ref": "common.schema.json#/definitions/Text" },
        "grantsClue": { "$ref": "common.schema.json#/definitions/Id" }
      },
      "required": ["id", "text"],
      "additionalProperties": false
    },
    "Line": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "required": ["id", "text"],
      "additionalProperties": false
    },
    "Rule": {
      "description": "Rules are checked in order; the first matching rule fires.",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "intent": { "$ref": "common.schema.json#/definitions/Id" },
        "tones": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Tone" }, "minItems": 1, "uniqueItems": true },
        "presented": {
          "description": "Clue or key ids the player must attach to the line.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/Id" },
          "uniqueItems": true
        },
        "missing": {
          "description": "Clue or key ids that must not be attached.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/Id" },
          "uniqueItems": true
        },
        "when": { "$ref": "common.schema.json#/definitions/Condition" },
        "suspicion": { "type": "integer", "minimum": -100, "maximum": 100 },
        "reply": { "$ref": "common.schema.json#/definitions/Id" },
        "revealFacts": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/Id" }, "uniqueItems": true },
        "effects": { "$ref": "common.schema.json#/definitions/Effects" }
      },
      "required": ["id", "suspicion", "reply"],
      "additionalProperties": false
    }
  }
}
